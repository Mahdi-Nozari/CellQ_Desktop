<Window x:Class="CellQ.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:controls="clr-namespace:CellQ.Desktop.Controls" Title="CellQ Desktop" Width="1120" Height="760" MinWidth="1040" MinHeight="700" Icon="/CellQ.Desktop;component/Assets/CellQ.ico" WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="NavigationTemplate"><Button Style="{StaticResource NavigationButton}" Command="{Binding Command}" CommandParameter="{Binding Destination}" AutomationProperties.Name="{Binding Destination}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="{Binding IconData}" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" /><AccessText Grid.Column="1" Text="{Binding Label}" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center" /></Grid></Button></DataTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
        <Grid x:Name="ShellRoot"><Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="66" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
            <Grid Background="#E6E6E6"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Canvas Width="136" Height="22" ClipToBounds="True" HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="CellQ"><Image Source="Assets/DisplayReference.png" Width="800" Height="480" Canvas.Left="-18" Canvas.Top="-20" /></Canvas>
                <TextBlock Grid.Column="1" Text="Desktop Maintenance" Foreground="#001D50" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" Padding="8,4" VerticalAlignment="Center" Margin="8,0,14,0"><TextBlock Text="DEVICE MONITOR" Foreground="#001D50" FontSize="10" FontWeight="SemiBold" /></Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" /><Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" /><Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" /></StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1" Padding="16,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="CONNECTION" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" /><StackPanel Orientation="Horizontal"><ComboBox Width="140" ItemsSource="{Binding Connection.Ports}" DisplayMemberPath="Label" SelectedValuePath="PortName" SelectedValue="{Binding Connection.SelectedPort}" IsEnabled="{Binding Connection.CanChoosePort}" AutomationProperties.Name="USB connection" ToolTip="Choose the USB connection for your CellQ." /><Button Content="Connect" Width="82" Margin="8,0,0,0" Command="{Binding Connection.ConnectCommand}" Visibility="{Binding Connection.ShowConnect, Converter={StaticResource BooleanToVisibility}}" /><Button Content="{Binding Connection.DisconnectLabel}" MinWidth="82" Margin="8,0,0,0" Command="{Binding Connection.DisconnectCommand}" Visibility="{Binding Connection.ShowDisconnect, Converter={StaticResource BooleanToVisibility}}" /><Button Content="↻" Command="{Binding Connection.RefreshPortsCommand}" Width="32" Padding="0" Margin="8,0,0,0" ToolTip="Find connected devices" AutomationProperties.Name="Find connected devices" /></StackPanel></StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource CanvasBrush}" Margin="0,3" />
                <StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock Text="{Binding CurrentPage.ActionGroup}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" /><StackPanel Orientation="Horizontal"><Button Content="{Binding CurrentPage.FirstAction}" Command="{Binding CurrentPage.FirstActionCommand}" IsEnabled="{Binding CurrentPage.FirstActionAvailable}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage.FirstAction}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="{Binding CurrentPage.SecondAction}" Command="{Binding CurrentPage.SecondActionCommand}" IsEnabled="{Binding CurrentPage.SecondActionAvailable}" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage.SecondAction}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></StackPanel>
                <TextBlock Grid.Column="3" Text="USB connection" Style="{StaticResource SecondaryText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0" />
            </Grid></Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource OutlineBrush}" Padding="12,18,12,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}" Foreground="White" Margin="12,0,0,14" />
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MainNavigation}" ItemTemplate="{StaticResource NavigationTemplate}" KeyboardNavigation.TabNavigation="Continue" />
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding UtilityNavigation}" ItemTemplate="{StaticResource NavigationTemplate}" Margin="0,12,0,12" />
                    <StackPanel Grid.Row="4" Margin="12,0"><Border Height="1" Background="{StaticResource SecondaryBlueBrush}" Margin="0,0,0,14" /><TextBlock Text="DEVICE" Style="{StaticResource Eyebrow}" Foreground="White" /><TextBlock Text="{Binding Connection.PortLabel}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,6" /><TextBlock Text="{Binding Connection.FirmwareSidebarLabel}" TextWrapping="Wrap" FontSize="12" Foreground="White" Margin="0,0,0,10" /><controls:StatusBadge Text="{Binding Connection.StatusLabel}" Tone="{Binding Connection.Tone}" /></StackPanel>
                </Grid></Border>
                <Grid Grid.Column="1" Margin="22,20,22,18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CELLQ MAINTENANCE" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" /><TextBlock Text="{Binding CurrentPage.Title}" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,16,0" /></StackPanel><controls:StatusBadge Grid.Column="1" Text="{Binding CurrentPage.ContentLabel}" VerticalAlignment="Center" /></Grid>
                    <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>
            </Grid>
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0"><Grid><TextBlock Text="{Binding Connection.FooterLabel}" Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center" /><TextBlock Text="CellQ Desktop" Style="{StaticResource SecondaryText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
        </Grid>
    </Border>
</Window>
