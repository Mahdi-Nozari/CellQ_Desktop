<UserControl x:Class="CellQ.Desktop.Controls.StatusBadge" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" AutomationProperties.Name="{Binding Text, ElementName=Root}">
    <Border Style="{StaticResource BadgeBorder}" Tag="{Binding Tone, ElementName=Root}">
        <TextBlock Text="{Binding Text, ElementName=Root}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
    </Border>
</UserControl>
