<UserControl x:Class="CellQ.Desktop.Views.DataLogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CellQ.Desktop.Controls">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,16" Padding="16,12"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding AccessHint}" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,0,16,0" /><Button Grid.Column="1" Content="Return to normal" Command="{Binding ReturnNormalCommand}" Visibility="{Binding ShowReturnNormal, Converter={StaticResource BooleanToVisibility}}" /></Grid>
            <TextBlock Text="Choose the same save location to resume an interrupted download." Style="{StaticResource SecondaryText}" Margin="0,8,0,0" /><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Open log file…" Command="{Binding OpenGraphFileCommand}" ToolTip="Graph a local CSV without connecting a device." /></StackPanel>
        </StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="On the device" Style="{StaticResource PanelTitle}" /><TextBlock Text="{Binding VisibleCount}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0" /></StackPanel><TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Tag="Search logs" ToolTip="Search by preset name, filename or folder." Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="Search device logs" /></Grid>
            <Grid Grid.Row="1"><DataGrid ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog}" AutomationProperties.Name="Device logs"><DataGrid.Columns>
                <DataGridTextColumn Header="Preset" Binding="{Binding PresetName}" Width="1.5*" MinWidth="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding PresetName}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="1.6*" MinWidth="155" ElementStyle="{StaticResource MonoCell}" />
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1*" MinWidth="94" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="0.7*" MinWidth="82" />
                <DataGridTemplateColumn Header="Saved copy" SortMemberPath="Verification" Width="1.5*" MinWidth="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:StatusBadge Text="{Binding Verification}" Tone="{Binding Tone}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns></DataGrid><TextBlock Text="{Binding EmptyMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding FilteredLogs.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <Grid Grid.Row="2" Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding SelectedLog.Filename, TargetNullValue=Select a log, FallbackValue=Select a log}" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedLog.LocalPath, TargetNullValue=Download a verified copy before deleting a device log., FallbackValue=Download a verified copy before deleting a device log.}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="View graph" Command="{Binding ViewGraphCommand}" Margin="0,0,8,0" /><Button Content="Use saved copy…" Command="{Binding UseCopyCommand}" Margin="0,0,8,0" /><Button Content="Delete from device…" Command="{Binding DeleteCommand}" /></StackPanel></Grid>
        </Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="16,12"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" /><TextBlock Text="{Binding ProgressLabel}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0" /></StackPanel><controls:StatusBadge Grid.Column="1" Text="{Binding StatusLabel}" Tone="{Binding Tone}" VerticalAlignment="Center" /><Button Grid.Column="2" Content="Stop" Command="{Binding CancelCommand}" Margin="12,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" /></Grid>
            <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" AutomationProperties.Name="Checked download progress" />
            <Expander Header="Technical details" Margin="0,10,0,0" Visibility="{Binding HasTechnicalError, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{Binding TechnicalError}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0" /></Expander>
        </StackPanel></Border>
    </Grid>
</UserControl>
