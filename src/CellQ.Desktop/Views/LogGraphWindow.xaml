<Window x:Class="CellQ.Desktop.Views.LogGraphWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CellQ.Desktop.Controls" Title="CellQ · Log graph" Width="1080" Height="740" MinWidth="960" MinHeight="700" Icon="/CellQ.Desktop;component/Assets/CellQ.ico" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource CanvasBrush}" Padding="20,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel>
            <TextBlock Text="PRESSURE GRAPH" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,16,4"/>
            <TextBlock Text="{Binding SourceName}" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceName}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
        </StackPanel><controls:StatusBadge Grid.Column="1" Text="{Binding SourceKind}" Tone="Info" VerticalAlignment="Top"/></Grid>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,12"><StackPanel>
            <Grid IsEnabled="{Binding HasData}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="Time span" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/><StackPanel Orientation="Horizontal"><TextBox Width="112" Text="{Binding SpanText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Time span" ToolTip="Enter seconds, or hours:minutes:seconds."><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ApplySpanCommand}"/></TextBox.InputBindings></TextBox><Button Content="Apply" Command="{Binding ApplySpanCommand}" Margin="6,0,0,0"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0" MinWidth="100"><Grid><TextBlock Text="Whole test" Style="{StaticResource SecondaryText}"/><TextBlock Text="More detail" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></Grid><Slider Minimum="0" Maximum="100" Value="{Binding ZoomPosition, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,11,0,0" AutomationProperties.Name="Time zoom" ToolTip="Move right to show a shorter time range."/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Jump to time" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/><StackPanel Orientation="Horizontal"><TextBox Width="118" Text="{Binding JumpText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Jump to elapsed time" ToolTip="Enter seconds or hours:minutes:seconds. The graph centers on that time."><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding JumpCommand}"/></TextBox.InputBindings></TextBox><Button Content="Go" Command="{Binding JumpCommand}" Margin="6,0,0,0"/></StackPanel></StackPanel>
                <Button Grid.Column="3" Content="Show whole test" Command="{Binding ShowAllCommand}" VerticalAlignment="Bottom"/>
            </Grid>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}"/>
        </StackPanel></Border>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Channels}" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,6,0"><StackPanel>
                <StackPanel Orientation="Horizontal"><Rectangle Fill="{Binding Brush}" Width="4" Height="18" Margin="0,0,8,0"/><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Foreground="{DynamicResource TextBrush}" FontSize="13" VerticalAlignment="Center" ToolTip="Show or hide this channel."/></StackPanel>
                <TextBlock Text="{Binding Reading}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="12,5,0,0"/>
            </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <controls:PressurePlot x:Name="Plot" Model="{Binding}" TextBrush="{DynamicResource TextBrush}" SurfaceBrush="{DynamicResource SurfaceBrush}" GridBrush="{DynamicResource DividerBrush}" SecondaryBrush="{DynamicResource SecondaryTextBrush}" MinHeight="140" Focusable="True" AutomationProperties.Name="Six-channel pressure versus elapsed time graph" ToolTip="Drag horizontally to move through time. Mouse wheel zooms; arrow keys pan."/>
            <Grid Grid.Row="1" Margin="8,5,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="◀" Command="{Binding EarlierCommand}" Padding="8,4" ToolTip="Move earlier" AutomationProperties.Name="Move graph earlier"/><ScrollBar Grid.Column="1" Orientation="Horizontal" Minimum="{Binding MinimumStart}" Maximum="{Binding MaximumStart}" Value="{Binding Start, Mode=TwoWay}" ViewportSize="{Binding Span}" IsEnabled="{Binding HasData}" Margin="8,0" VerticalAlignment="Center" AutomationProperties.Name="Graph time position"/><Button Grid.Column="2" Content="▶" Command="{Binding LaterCommand}" Padding="8,4" ToolTip="Move later" AutomationProperties.Name="Move graph later"/></Grid>
        </Grid></Border>
        <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ViewRange}" FontSize="12"/><TextBlock Text="{Binding ReadingTime}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/><TextBlock Text="{Binding MissingNotice}" Style="{StaticResource SecondaryText}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SourceNotice}" Style="{StaticResource SecondaryText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,0,0"/></Grid>
    </Grid></Border>
</Window>
